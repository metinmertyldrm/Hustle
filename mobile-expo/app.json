{
  "expo": {
    "name": "Hustle",
    "slug": "hustle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hustle",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.hustle.mobile" },
    "android": { "package": "com.hustle.mobile" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-font"],
    "experiments": { "typedRoutes": true }
  }
}
